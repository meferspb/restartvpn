<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RestartVPN</AssemblyName>
    <RootNamespace>RestartVpn.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compile the core sources into the single executable: the release artifact must be one exe. -->
    <Compile Include="..\..\src\RestartVpn.Core\**\*.cs" Exclude="..\..\src\RestartVpn.Core\bin\**;..\..\src\RestartVpn.Core\obj\**" LinkBase="Core" />
  </ItemGroup>
</Project>
